# ══════════════════════════════════════════════════════════════════
# دليل الأحكام — Dalil Al-Ahkam · environment template
# Copy to `.env` and fill in the three keys below — everything else
# has working defaults. Verified live stack 2026-10-05.
# ══════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ─────────────────────────────
# Local dev (matches docker-compose.yml). For Vercel use a remote
# Postgres+pgvector URL (Neon has pgvector built in).
DATABASE_URL=postgresql://postgres:aboodandabood@localhost:5432/dalil_al_ahkam

# ── [1/3] Embeddings — Cloudflare Workers AI (key REQUIRED) ──────
# Dashboard: https://dash.cloudflare.com/<ACCOUNT_ID>/workers-ai
# Create an API token with Workers AI permission:
#   https://dash.cloudflare.com/profile/api-tokens
# bge-m3 outputs 1024 dims — matches the `vector(1024)` column.
# (Both endpoint styles work: OpenAI-compat `.../ai/v1` and native
#  `.../ai/run` — lib/ai/siliconflow.ts auto-detects.)
EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/43902acd688df596d710d64a43971a9e/ai/v1
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_API_KEY=

# ── [2/3] Reranker — Cohere (key REQUIRED) ──────────────────────
# Dashboard: https://dashboard.cohere.com/api-keys
# lib/ai/siliconflow.ts POSTs {base}/rerank → api.cohere.com/v2/rerank
RERANKER_BASE_URL=https://api.cohere.com/v2
RERANKER_MODEL=rerank-multilingual-v3.0
RERANKER_API_KEY=

# ── [3/3] LLM — OpenRouter FREE models (key REQUIRED even for free)
# Create a free key: https://openrouter.ai/keys (no credit card)
# Verified fast + clean Arabic 2026-10-06 (~10s full pipeline; gemma-4-31b
# was persistently 429-limited upstream). lib/ai/llm.ts retries 429 once
# and falls back to `reasoning` for thinking models.
# Alternatives verified: nvidia/nemotron-3-ultra-550b-a55b:free (better,
# slower ~2min), dots-studio/dots-3-note-preview:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free
LLM_REWRITE_MODEL=google/gemma-4-31b-it:free
LLM_API_KEY=

# ── RAG pipeline tuning (defaults are fine) ─────────────────────
# Step 3: how many candidates cosine search returns
RAG_RECALL_K=30
# Step 4: how many the reranker keeps for display
RAG_FINAL_K=10
# Cutoff: cosine similarity below this is hidden as irrelevant
RAG_MIN_SCORE=0.30
# Step 2: light-LLM query rewriter (true = always run, graceful fallback)
QUERY_REWRITE_ENABLED=true
# Min question length (chars) before the rewriter LLM is called (default 24; 0 = always send to AI)
QUERY_REWRITE_MIN_LENGTH=24
# Step 6: LLM summary — set false for HADITHS-ONLY answers (no summary box)
RAG_ANSWER_ENABLED=true

# ── Cost display (per-request USD estimate on the ask page) ──────
# Defaults use published prices; override if you switch models:
#   Cloudflare bge-m3 = $0.0118 / 1M input tokens
#   Cohere rerank     = $2.00 / 1K search units ($0.002 per call)
#   OpenRouter :free  = $0
# COST_EMBED_USD_PER_MTOK=0.0118
# COST_RERANK_USD_PER_CALL=0.002
# COST_LLM_USD_PER_MTOK=0
# COST_REWRITE_USD_PER_MTOK=0

# ── OpenRouter attribution (optional, shown on openrouter.ai) ────
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Dalil Al-Ahkam

# ── Alternatives ─────────────────────────────────────────────────
# Offline dev (local Ollama, keyless): point *_BASE_URL at
#   http://localhost:11434/v1 (bge-m3 + qwen3.5:0.8b/4b)
# SiliconFlow (embeddings + reranker on one key):
#   https://api.siliconflow.cn/v1 · BAAI/bge-m3 + BAAI/bge-reranker-v2-m3
# OpenRouter reranker: voyageai/rerank-3-lite (paid)
#
# ⚠ Embedding consistency: corpus + queries MUST use the SAME
#   embedding provider. After ANY switch run: npm run db:reembed
