# ══════════════════════════════════════════════════════════════════
# دليل الأحكام — Dalil Al-Ahkam · environment template
# Copy to `.env` and fill in the keys below — everything else has
# working defaults. Live stack verified 2026-10-06.
#
# ⚠ NEVER commit real keys/passwords to git — `.env` is gitignored.
#    This file (.env.example) keeps every secret EMPTY on purpose.
# ══════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ─────────────────────────────
# Windows `next dev` (primary): localhost works directly.
# Same corpus as production: 2 books · 2,656 rows · 2,213 searchable.
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/dalil_al_ahkam

# WSL script runs ONLY (WSL NAT blocks localhost:5432) — prefix commands:
#   DATABASE_URL=postgresql://postgres:<PASSWORD>@172.28.32.1:5432/dalil_al_ahkam npx tsx scripts/...
# (keep the default above as localhost — Windows dev is primary)

# PRODUCTION (Vercel env vars — never run db:migrate against it, no
# _prisma_migrations history; schema came from pg_dump):
# DATABASE_URL=postgres://<USER>:<PASSWORD>@pooled.db.prisma.io:5432/postgres?sslmode=require

# ── Embeddings — @cf/baai/bge-m3 via Cloudflare Workers AI (1024 dims) ──
# Dashboard: https://dash.cloudflare.com/<ACCOUNT_ID>/workers-ai
# Create an API token with Workers AI permission:
#   https://dash.cloudflare.com/profile/api-tokens
# Both endpoint styles work (lib/ai/siliconflow.ts auto-detects):
#   OpenAI-compat (recommended): .../ai/v1   ·   native: .../ai/run
EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_API_KEY=

# ── Reranker — rerank-multilingual-v3.0 via Cohere v2 (verified live) ──
# Dashboard: https://dashboard.cohere.com/api-keys
# lib/ai/siliconflow.ts posts {base}/rerank → https://api.cohere.com/v2/rerank
RERANKER_BASE_URL=https://api.cohere.com/v2
RERANKER_MODEL=rerank-multilingual-v3.0
RERANKER_API_KEY=

# ── LLM — Gemini via Google AI Studio (answer + light query rewriter) ──
# Get a key: https://aistudio.google.com/apikey (starts with "AIza…")
# OpenAI-compatible endpoint — no code change needed.
# gemini-3.5-flash-lite = fast + cheap; good Arabic for the rewriter.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_REWRITE_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# ── OpenRouter key (OPTIONAL — fills any empty *_API_KEY above) ──
# Only needed if you switch a *_BASE_URL back to https://openrouter.ai/api/v1
# (free models still need a key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ── RAG pipeline tuning ──────────────────────────────────────────
# Step 3: how many candidates cosine search returns (diagram: 30)
RAG_RECALL_K=30
# Step 4: how many the reranker keeps for display
RAG_FINAL_K=3
# Cutoff: cosine similarity below this is hidden as irrelevant (0.40 = 40%)
RAG_MIN_SCORE=0.40
# Step 2: light-LLM query rewriter (true = always run, graceful fallback)
QUERY_REWRITE_ENABLED=true
# Min question length in chars before the rewriter LLM is called
# (0 = always send to AI, even tiny questions)
QUERY_REWRITE_MIN_LENGTH=0
# Step 6: LLM summary — false = HADITHS-ONLY answers (no «الخلاصة» box;
# the reranked hadith list + citations are still returned)
RAG_ANSWER_ENABLED=false

# ── Cost display (per-request USD estimate on the ask page) ──────
# Defaults: Cloudflare bge-m3 $0.0118/1M tok · Cohere rerank $0.002/call.
# Gemini flash-lite pricing is NOT auto-detected — set it to count it:
#   e.g. flash-lite tier ≈ $0.10/1M in, $0.40/1M out → ~$0.0001/rewrite
# COST_EMBED_USD_PER_MTOK=0.0118
# COST_RERANK_USD_PER_CALL=0.002
# COST_REWRITE_USD_PER_MTOK=0.1
# COST_LLM_USD_PER_MTOK=0.1

# ── OpenRouter attribution (shown on openrouter.ai activity) ─────
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Dalil Al-Ahkam

# ── Alternatives ─────────────────────────────────────────────────
# Offline dev (local Ollama, keyless): point *_BASE_URL at http://localhost:11434/v1
#   (bge-m3 + qwen3.5:0.8b/4b). ⚠ After ANY embedding-provider switch run:
#   npm run db:reembed   (re-embeds the corpus with the current provider)
# SiliconFlow (embeddings + BAAI/bge-reranker-v2-m3 reranker):
#   EMBEDDING_BASE_URL / RERANKER_BASE_URL = https://api.siliconflow.cn/v1
#   key: https://cloud.siliconflow.cn/account/ak
# OpenRouter chat models (need sk-or-v1-… key):
#   LLM_BASE_URL=https://openrouter.ai/api/v1 · LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
