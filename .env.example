# ── Database (PostgreSQL + pgvector) ─────────────────────────────
# Local dev default (docker-compose.yml matches these credentials):
DATABASE_URL=postgresql://postgres:aboodandabood@localhost:5432/dalil_al_ahkam

# ── OpenRouter — the ONLY required key ───────────────────────────
# https://openrouter.ai/keys — starts with sk-or-v1-…, needs credits.
# Shared by all three models; per-model EMBEDDING_API_KEY / RERANKER_API_KEY
# / LLM_API_KEY override it when different keys are needed.
OPENROUTER_API_KEY=sk-or-v1-

# ── Embeddings — baai/bge-m3 via OpenRouter (1024 dims) ──────────
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=baai/bge-m3

# ── Reranker — voyageai/rerank-3-lite via OpenRouter (default) ────
RERANKER_BASE_URL=https://openrouter.ai/api/v1
RERANKER_MODEL=voyageai/rerank-3-lite
#   Cohere v2 alternative (verified working): RERANKER_BASE_URL=https://api.cohere.com/v2
#   · RERANKER_MODEL=rerank-multilingual-v3.0 · RERANKER_API_KEY=<Cohere key>

# ── LLM — OpenRouter chat (answer + light query rewriter) ────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_REWRITE_MODEL=meta-llama/llama-3.1-8b-instruct

# ── RAG pipeline tuning ──────────────────────────────────────────
# Step 3: how many candidates cosine search returns (diagram: 30)
RAG_RECALL_K=30
# Step 4: how many the reranker keeps for display (diagram: 10)
RAG_FINAL_K=10
# Cutoff: cosine similarity below this is hidden as irrelevant (0.30 = 30%)
RAG_MIN_SCORE=0.30
# Step 2: light-LLM query rewriter (true = always run, graceful fallback)
QUERY_REWRITE_ENABLED=true

# ── OpenRouter attribution ────────────────────────────────────────
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Dalil Al-Ahkam

# ── Alternatives ─────────────────────────────────────────────────
# Offline dev (local Ollama, keyless): point *_BASE_URL at http://localhost:11434/v1
# SiliconFlow (embeddings + BAAI/bge-reranker-v2-m3 reranker):
#   *_BASE_URL=https://api.siliconflow.cn/v1 · key: cloud.siliconflow.cn/account/ak
# Cloudflare Workers AI bge-m3 (1024 dims, same as baai/bge-m3 — no DB change):
#   Option A — OpenAI-compatible (recommended):
#     EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
#     EMBEDDING_MODEL=@cf/baai/bge-m3
#     EMBEDDING_API_KEY=<Cloudflare API token with Workers AI permission>
#   Option B — native REST:
#     EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run
#     EMBEDDING_MODEL=@cf/baai/bge-m3
#     EMBEDDING_API_KEY=<same token>
#   Keep reranker + LLM on OpenRouter (voyageai/rerank-3-lite + llama-3.1-8b).
# ⚠ Embedding consistency: corpus + queries MUST use the same embedding
#   provider. After a switch run: npm run db:reembed
